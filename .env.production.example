# CRM Planner Production Environment Configuration
# Copy this file to .env.production or configure these variables in your deployment platform (Vercel, Netlify, Firebase, etc.)

# Firebase Authentication & Database Configuration
VITE_FIREBASE_API_KEY=your_production_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Operational Settings & Security
VITE_APP_TITLE=EMU Australia CRM Planner
VITE_ENABLE_MOCK_FALLBACK=false
VITE_INITIAL_ADMIN_EMAIL=your_admin_email@domain.com
